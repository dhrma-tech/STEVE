# Local development defaults
# Postgres connection string. Blank in development means the local cluster from `pnpm db:local`
# (postgresql://steve:steve@localhost:54320/steve). Required in production (e.g. Supabase's pooled URL).
# First time: pnpm db:local (own terminal), then pnpm db:migrate && pnpm db:seed
# (or pnpm db:import-sqlite to copy over an old prisma/dev.db).
DATABASE_URL=""
PRISMA_POOL_MAX=10                # connections per process
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required in production: random, at least 32 chars (e.g. `openssl rand -base64 48`).
# The placeholder below only works in development.
AUTH_SECRET="replace-me-for-provider-mode"

# AI providers (required for real agent execution)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Search (optional — improves web_search beyond DuckDuckGo fallback)
BRAVE_SEARCH_API_KEY=""

# GitHub OAuth + agent token
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_TOKEN=""

# Hosting
VERCEL_TOKEN=""

# Database
SUPABASE_PROJECT_REF=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
# Management API token for supabase_run_query (generate at supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Social publishing
POSTIZ_API_KEY=""
POSTIZ_API_URL=""

# Prospect scraping
APIFY_TOKEN=""

# Email outreach (Resend)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Monitoring
POSTHOG_API_KEY=""
SENTRY_AUTH_TOKEN=""

# Support (Plain.com)
PLAIN_API_KEY=""
SUPPORT_API_URL=""

# File storage
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""


# Agent orchestration
# Reserved flag. Nothing reads it yet (Phase 3 shipped without needing it).
ORCHESTRATOR_V2=""
# Global kill switch: set to 1 to stop every agent run from starting.
AGENTS_PAUSED=""

# Agent guardrails (defaults shown; an org can override budgets in agent policy settings)
AGENT_RUN_BUDGET_CENTS=200        # estimated model spend per run tree
AGENT_DAILY_BUDGET_CENTS=1000     # estimated model spend per organization per day
AGENT_MAX_DEPTH=3                 # delegation levels below the root agent
AGENT_MAX_STEPS=60                # model turns per run tree
AGENT_MAX_TOOL_CALLS=100          # tool calls per run tree
APPROVAL_TIMEOUT_MINUTES=1440     # how long a run waits for a human approval (runs wait in the database, so this can be long)
AGENT_TOOL_TIMEOUT_MS=60000       # a single tool call is failed after this long
MODEL_RETRY_BASE_MS=500           # first quick retry delay for a failed model call (doubles each retry)

# Model tiers (src/lib/ai/model-tiers.ts). Defaults shown; FALLBACK=none turns the outage fallback off.
# MODEL_PLANNER=claude-opus-5-5     MODEL_PLANNER_EFFORT=high     MODEL_PLANNER_FALLBACK=claude-sonnet-5-5
# MODEL_WORKER=claude-sonnet-5-5    MODEL_WORKER_EFFORT=medium    MODEL_WORKER_FALLBACK=claude-opus-5-5
# MODEL_TRIAGE=claude-haiku-4-5     (Haiku takes no effort)       MODEL_TRIAGE_FALLBACK=claude-sonnet-5-5

# Observability. LOG_FORMAT is json in production, pretty elsewhere. SENTRY_DSN sends unexpected run/worker errors to Sentry.
# LOG_LEVEL=info
# LOG_FORMAT=json
SENTRY_DSN=""

# Automations (Phase 9: schedules, triggers, Slack/webhook channels, public API)
# Secret vault (Phase 10): master key ring, active key first, older keys kept to decrypt until `pnpm secrets:rotate`.
# Each key is 32 bytes (base64 or hex). Without it: SECRETS_ENCRYPTION_KEY (key id k0), else a key derived from AUTH_SECRET.
SECRETS_MASTER_KEYS=""
SECRETS_ENCRYPTION_KEY=""
# In production tools use only each org's own credentials; set to 1 to let them fall back to the global keys above.
ALLOW_GLOBAL_TOOL_CREDENTIALS=""
# How many times one trigger may start work per hour; further events are recorded and ignored.
TRIGGER_MAX_PER_HOUR=30

# Agent worker (durable runtime). Runs are stored in the database and advanced by a worker, step by step.
#   inline   - the web server runs a worker itself (default; enough for `pnpm dev` and a single server)
#   external - the web server runs none; start `pnpm worker` (as many as you like) or call the tick route
#   off      - no worker in the web server
AGENT_WORKER=inline
AGENT_WORKER_CONCURRENCY=4        # jobs one worker handles at the same time
# Serverless fallback: POST /api/internal/worker/tick with `Authorization: Bearer <secret>` every minute
# works through due jobs for ~50 s. The route returns 404 while this is blank.
WORKER_TICK_SECRET=""
# Job queue: db (default, the Job table with SKIP LOCKED claims) or pg-boss (jobs in pg-boss's own schema).
AGENT_QUEUE=db
# Postgres LISTEN/NOTIFY wakes workers and live streams in other processes at once (they poll either way).
# Set to off behind a transaction-mode pooler such as PgBouncer, which cannot hold a LISTEN connection.
PG_NOTIFY=on

# OAuth connect for integrations (Phase 10). Each provider is offered when its client id and secret are set.
# Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/oauth/<provider>/callback
GITHUB_INTEGRATION_CLIENT_ID=""
GITHUB_INTEGRATION_CLIENT_SECRET=""
VERCEL_CLIENT_ID=""
VERCEL_CLIENT_SECRET=""
VERCEL_INTEGRATION_SLUG=""
STRIPE_CONNECT_CLIENT_ID=""
SUPABASE_OAUTH_CLIENT_ID=""
SUPABASE_OAUTH_CLIENT_SECRET=""

# Rate limits: RATE_LIMIT_<BUCKET>=<limit>/<window seconds>; buckets AUTH, RUN_START, UPLOAD, APPROVAL, API_READ, API_WRITE, HOOK.
# RATE_LIMITS=off turns them all off.
# RATE_LIMIT_RUN_START=30/60

# Backups (pnpm db:backup)
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# PG_DUMP=
