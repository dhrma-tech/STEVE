# Local development defaults
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-me-for-provider-mode"

# AI providers (required for real agent execution)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Search (optional — improves web_search beyond DuckDuckGo fallback)
BRAVE_SEARCH_API_KEY=""

# GitHub OAuth + agent token
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_TOKEN=""

# Hosting
VERCEL_TOKEN=""

# Database
SUPABASE_PROJECT_REF=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
# Management API token for supabase_run_query (generate at supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Social publishing
POSTIZ_API_KEY=""
POSTIZ_API_URL=""

# Prospect scraping
APIFY_TOKEN=""

# Email outreach (Resend)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Monitoring
POSTHOG_API_KEY=""
SENTRY_AUTH_TOKEN=""

# Support (Plain.com)
PLAIN_API_KEY=""
SUPPORT_API_URL=""

# File storage
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

